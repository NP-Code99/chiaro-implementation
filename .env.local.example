DATABASE_URL="postgresql://postgres:postgres@localhost:5432/chiaro"
ANTHROPIC_API_KEY="sk-ant-..."

# Session cookie encryption — generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# Startup.jobs scraping (Apify actor: shahidirfan~Startup-Jobs-Scraper)
# Used on feature/startup-jobs-integration branch
STARTUP_JOBS_API_KEY=

# Wellfound job scraping (Apify actor) — main branch only
# WELLFOUND_API_KEY=

# Apify residential proxy — used by Playwright for Cloudflare bypass
APIFY_API_KEY=

# CapSolver — solves Turnstile CAPTCHAs if they appear (~$0.001/solve)
# Optional: leave blank to skip CAPTCHA solving
CAPSOLVER_API_KEY=

# Scrapfly — fetches Cloudflare-protected pages (asp:true + residential pool)
# Used for form-field reconnaissance on external ATS pages (Greenhouse, Lever, etc.)
# Get a key at scrapfly.io — free tier includes 1,000 API calls/month
SCRAPFLY_API_KEY=

# Residential proxy for Playwright — bypasses DataDome on apply flows
# Format: http://USERNAME:PASSWORD@HOSTNAME:PORT
# Recommended providers (cheapest first):
#   Webshare:     https://proxy.webshare.io  (~$15/mo for 100 residential IPs)
#   PacketStream: https://packetstream.io    (~$1/GB)
#   IPRoyal:      https://iproyal.com        (~$3.50/GB)
#   Bright Data:  https://brightdata.com     (~$15/GB, most reliable)
# Leave blank to fall back to Scrapfly cookie injection
RESIDENTIAL_PROXY_URL=
# Dedicated residential proxy for DataDome CapSolver tasks (use a session-locked IP
# to keep the same IP through the full challenge/cookie cycle — djssmwzl-1 suffix
# pins a specific Webshare session). Falls back to RESIDENTIAL_PROXY_URL if unset.
DATADOME_PROXY_URL=

# Steel.dev Starter plan API key — provides a cloud Chrome browser with
# residential proxy and built-in CAPTCHA solving (DataDome, Cloudflare Turnstile)
# Replaces local Playwright browser launch; everything else (Scrapfly, CapSolver) stays.
# Get from: app.steel.dev → Settings → API Keys
# Required for browser automation bypass of DataDome and Cloudflare
STEEL_API_KEY=
