# Redis connection (required for job queue)
REDIS_URL=redis://localhost:6379

# AES-256 key for encrypting session files at rest — use a long random string
SESSION_ENCRYPTION_KEY=change-me-to-a-long-random-secret

# Optional: lock the automation server behind an API key
AUTOMATION_API_KEY=

# Port for the Express server
AUTOMATION_PORT=3001
