generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String        @id @default(cuid())
  name         String        @default("")
  email        String        @unique @default("")
  phone        String?
  linkedinUrl  String?
  githubUrl    String?
  location     String?
  resumePath   String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  applications Application[]
}

model Job {
  id           String        @id @default(cuid())
  company      String
  role         String
  description  String
  applyUrl     String
  atsType      AtsType
  location     String
  salaryMin    Int?
  salaryMax    Int?
  tags               String[]
  logoUrl            String?
  manualReviewReason String?   // Set when a fillability check determines the form can't be auto-filled
  createdAt          DateTime      @default(now())
  applications       Application[]
}

model Application {
  id              String            @id @default(cuid())
  userId          String
  jobId           String
  status          ApplicationStatus @default(PENDING)
  errorMessage    String?
  appliedAt       DateTime?
  profileSnapshot String?           // JSON snapshot of UserProfile at time of apply
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  user            User              @relation(fields: [userId], references: [id])
  job             Job               @relation(fields: [jobId], references: [id])

  @@unique([userId, jobId])
  pausedApplication PausedApplication?
}

model PausedApplication {
  id               String      @id @default(cuid())
  applicationId    String      @unique
  jobId            String
  pendingQuestions String      // JSON: [{fieldLabel, fieldType, selector}]
  pageUrl          String
  cookieState      String      // JSON: serialized Playwright cookies
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  application      Application @relation(fields: [applicationId], references: [id])
}

enum AtsType {
  GREENHOUSE
  LEVER
  WORKDAY
  CUSTOM
}

enum ApplicationStatus {
  PENDING
  APPLYING
  APPLIED
  FAILED
  NEEDS_REVIEW
  NEEDS_INFO
}
